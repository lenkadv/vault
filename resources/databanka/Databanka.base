filters:
  and:
    - file.inFolder("resources/databanka")
    - note.databanka == true
views:
  - type: table
    name: Vše podle zdroje
    groupBy:
      property: zdroj
      direction: ASC
    order:
      - file.name
      - typ
      - nainstalovano
      - stav
      - verdikt
      - pouzij_kdyz
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: Nainstalované nástroje
    filters:
      and:
        - note.nainstalovano == "ano"
    groupBy:
      property: zdroj
      direction: ASC
    order:
      - file.name
      - stav
      - verdikt
      - pouzij_kdyz
      - spousteni
    sort:
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 260
      note.pouzij_kdyz: 420
      note.spousteni: 260
  - type: table
    name: Kurzy a tutoriály
    filters:
      and:
        - note.typ == "tutoriál"
    order:
      - file.name
      - zdroj
      - pouzij_kdyz
      - stav
      - pro
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: Používám
    filters:
      and:
        - note.stav == "použito"
    order:
      - file.name
      - zdroj
      - verdikt
      - pouzij_kdyz
    columnSize:
      file.name: 260
      note.pouzij_kdyz: 420
  - type: table
    name: Skryté a vyřazené
    filters:
      or:
        - note.verdikt == "skrýt"
        - note.verdikt == "vyřadit"
    order:
      - file.name
      - verdikt
      - zdroj
      - pouzij_kdyz
    columnSize:
      file.name: 260
      note.pouzij_kdyz: 420
  - type: table
    name: Vše podle tématu
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - pro
      - tema
      - stav
      - verdikt
      - rok
      - zdroj
    sort:
      - property: tema
        direction: ASC
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: Neprozkoumáno
    filters:
      and:
        - note.stav == "neprozkoumáno"
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - pro
      - tema
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: DigiStart
    filters:
      and:
        - note.pro.contains("DigiStart")
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - tema
      - stav
      - verdikt
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: Evident
    filters:
      and:
        - note.pro.contains("Evident")
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - tema
      - stav
      - verdikt
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: lcenglish
    filters:
      and:
        - note.pro.contains("lcenglish")
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - tema
      - stav
      - verdikt
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: tadylenka
    filters:
      and:
        - note.pro.contains("tadylenka")
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - tema
      - stav
      - verdikt
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: Konzultace
    filters:
      and:
        - note.pro.contains("konzultace")
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - tema
      - stav
      - verdikt
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: Pro mě
    filters:
      and:
        - note.pro.contains("vlastní")
    order:
      - file.name
      - typ
      - pouzij_kdyz
      - tema
      - stav
      - verdikt
    columnSize:
      file.name: 300
      note.pouzij_kdyz: 420
  - type: table
    name: Použité a prohlédnuté
    filters:
      and:
        - note.stav != "neprozkoumáno"
    order:
      - file.name
      - stav
      - verdikt
      - pouzij_kdyz
      - pro
    columnSize:
      file.name: 300
